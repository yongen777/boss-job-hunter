{
  "manifest_version": 3,
  "name": "BOSS直聘求职猎手",
  "version": "0.1.0",
  "description": "配合本地桥在真实浏览器里采集岗位、投递、读回复。不使用任何调试端口。",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8898/*",
    "http://localhost:8898/*",
    "https://www.zhipin.com/*",
    "https://zhipin.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*", "https://zhipin.com/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BOSS直聘求职猎手"
  }
}